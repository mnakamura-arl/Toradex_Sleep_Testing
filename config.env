### GENERAL ###
SYSTEM_ID=SLEEP_TEST


### SENSING ###

UPDATE_PERIOD_MS=1000
# Set the update period of the sensors in milliseconds


### LOGGING ###

LOGGING_LEVEL=INFO
# Set the minimum logging level of the sensors
# (DEBUG, INFO, WARNING, ERROR, CRITICAL)


### DATABASE ###
# For sensor services, not the postgres service
DB_USER_FILE=/run/secrets/db_user
DB_NAME=data
DB_PASSWORD_FILE=/run/secrets/db_password
